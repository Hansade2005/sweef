<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v4 alternative to the NSIS installer (MSI). NOT built by default and NOT tested in this repository's CI yet:
  the NSIS installer is the primary one. Build on Windows with the .NET SDK:
      dotnet tool install -g wix
      wix build -arch x64 -d Version=0.1.0.7 -d SrcDir=dist\bin\windows_amd64 -d Icon=dist\icons\sweef.ico ^
          packaging\windows\wix\Package.wxs -o dist\sweef_windows_amd64.msi
  Per-user by default (no UAC); "perUserOrMachine" lets msiexec ALLUSERS=1 install per machine.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Sweef (alpha)" Manufacturer="Sweef" Version="$(Version)" UpgradeCode="6A1B2C3D-4E5F-4A6B-8C7D-9E0F1A2B3C4D"
           Scope="perUserOrMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Sweef is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="SweefIcon" SourceFile="$(Icon)" />
    <Property Id="ARPPRODUCTICON" Value="SweefIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/sweefbrowser/sweef" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Sweef" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="SweefStartMenu" Name="Sweef" Target="[INSTALLFOLDER]Sweef.exe" Icon="SweefIcon" />
        <RegistryValue Root="HKCU" Key="Software\Sweef" Name="startmenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <ComponentGroup Id="Files" Directory="INSTALLFOLDER">
      <Component Guid="*">
        <File Id="SweefCli" Source="$(SrcDir)\sweef.exe" KeyPath="yes" />
      </Component>
      <Component Guid="*">
        <File Id="SweefGui" Source="$(SrcDir)\Sweef.exe" KeyPath="yes" />
        <ProgId Id="SweefHTML" Description="Sweef HTML Document" Icon="SweefIcon">
          <Extension Id="html"><Verb Id="open" Command="Open" Argument="&quot;%1&quot;" /></Extension>
          <Extension Id="htm"><Verb Id="open" Command="Open" Argument="&quot;%1&quot;" /></Extension>
        </ProgId>
        <ProgId Id="SweefURL" Description="Sweef URL" Icon="SweefIcon">
          <Verb Id="open" Command="Open" Argument="&quot;%1&quot;" />
        </ProgId>
        <RegistryKey Root="HKMU" Key="Software\Clients\StartMenuInternet\Sweef">
          <RegistryValue Type="string" Value="Sweef" />
          <RegistryKey Key="Capabilities">
            <RegistryValue Name="ApplicationName" Type="string" Value="Sweef" />
            <RegistryValue Name="ApplicationDescription" Type="string" Value="Fast independent browser with a built-in agent" />
            <RegistryKey Key="FileAssociations">
              <RegistryValue Name=".htm" Type="string" Value="SweefHTML" />
              <RegistryValue Name=".html" Type="string" Value="SweefHTML" />
            </RegistryKey>
            <RegistryKey Key="URLAssociations">
              <RegistryValue Name="http" Type="string" Value="SweefURL" />
              <RegistryValue Name="https" Type="string" Value="SweefURL" />
              <RegistryValue Name="ftp" Type="string" Value="SweefURL" />
            </RegistryKey>
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]Sweef.exe&quot;" />
          </RegistryKey>
        </RegistryKey>
        <RegistryValue Root="HKMU" Key="Software\RegisteredApplications" Name="Sweef" Type="string"
                       Value="Software\Clients\StartMenuInternet\Sweef\Capabilities" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="Sweef" Level="1">
      <ComponentGroupRef Id="Files" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
