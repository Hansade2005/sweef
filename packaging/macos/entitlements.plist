<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime is enabled at signing time (codesign option: runtime).
       Sweef is pure Go with a QuickJS interpreter translated to Go: there is no JIT, so none of the
       com.apple.security.cs.allow-jit / allow-unsigned-executable-memory / disable-library-validation
       exceptions are requested. Add camera/microphone entitlements only when the engine gains
       getUserMedia support (and then the matching NS*UsageDescription keys in Info.plist). -->
  <key>com.apple.security.network.client</key><true/>
  <key>com.apple.security.network.server</key><true/>
</dict>
</plist>
