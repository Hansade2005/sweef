#!/bin/sh
set -e
case "$1" in
  remove|deconfigure)
    update-alternatives --remove x-www-browser /usr/bin/sweef-browser
    update-alternatives --remove gnome-www-browser /usr/bin/sweef-browser
    ;;
  upgrade|failed-upgrade) ;;
  *) echo "prerm called with unknown argument '$1'" >&2; exit 1 ;;
esac
exit 0
