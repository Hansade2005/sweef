#!/bin/sh
set -e
# Registers Sweef as a selectable (low priority) web browser alternative and refreshes caches.
# Priority 25 is deliberately low: an alpha browser must not silently become the system default.
case "$1" in
  configure)
    update-alternatives --install /usr/bin/x-www-browser x-www-browser /usr/bin/sweef-browser 25
    update-alternatives --install /usr/bin/gnome-www-browser gnome-www-browser /usr/bin/sweef-browser 25
    if command -v update-desktop-database >/dev/null 2>&1; then
      update-desktop-database -q /usr/share/applications || true
    fi
    if command -v gtk-update-icon-cache >/dev/null 2>&1 && [ -d /usr/share/icons/hicolor ]; then
      gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
    fi
    if command -v update-mime-database >/dev/null 2>&1 && [ -d /usr/share/mime ]; then
      update-mime-database /usr/share/mime >/dev/null 2>&1 || true
    fi
    ;;
  abort-upgrade|abort-remove|abort-deconfigure) ;;
  *) echo "postinst called with unknown argument '$1'" >&2; exit 1 ;;
esac
exit 0
